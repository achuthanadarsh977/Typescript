function longestValidSubstring(word: string, forbidden: string[]): number {
    let n = forbidden.length
    let maxlength = 0

    for(let i=0;i<n;i++){
        for(let j=0;j<n;j++){
            if(isUnique(word,i,j)){
                maxlength = Math.max(maxlength , j-i+1)
            }
        }
    }

    return maxlength
};


function isUnique(s:string,start:number,end:number):boolean{

    let chars = new Set()

    for(let k = start;k<=end;k++){
        if(chars.has(s.charAt(k))){
            return false
        }
        chars.add(s.charAt(k))
    }

    return true
}


